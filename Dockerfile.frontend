# --- Etapa de build: compila los estaticos con Node/Vite ---
FROM node:20-alpine AS build
WORKDIR /build

COPY package.json package-lock.json* ./
RUN npm install

COPY index.html vite.config.ts tsconfig.json tailwind.config.js postcss.config.js ./
COPY shared shared
COPY network-scanner/frontend network-scanner/frontend
COPY exposure-checker/frontend exposure-checker/frontend
COPY hygiene-checklist/frontend hygiene-checklist/frontend
COPY incident-guide/frontend incident-guide/frontend
COPY phishing-simulator/frontend phishing-simulator/frontend
COPY port-radar/frontend port-radar/frontend
COPY wifi-router-audit/frontend wifi-router-audit/frontend
COPY digital-footprint/frontend digital-footprint/frontend
COPY findings-report/frontend findings-report/frontend
COPY cryptojacking-detector/frontend cryptojacking-detector/frontend
COPY traffic-analyzer/frontend traffic-analyzer/frontend

# Vite incrusta las variables VITE_* en tiempo de build, no de ejecucion.
ARG VITE_API_BASE_URL=http://localhost:8080/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

# --- Etapa final: Nginx sirviendo los ficheros estaticos ---
FROM nginx:1.27-alpine

COPY --from=build /build/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
