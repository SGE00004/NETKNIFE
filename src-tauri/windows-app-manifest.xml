<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Common Controls con tema (necesario para la UI nativa de Windows); es el
       manifiesto por defecto de tauri-build, que se pierde al dar uno propio,
       asi que se conserva aqui explicitamente. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>

  <!-- NETKNIFE necesita permisos de administrador para poder cortar la conexion
       de un dispositivo no reconocido (ARP spoofing via Npcap). Se eleva toda la
       app al arrancar, en vez de solo al usar esa funcion. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
