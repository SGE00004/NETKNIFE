# Puerto en el que escucha el backend (Spring Boot). Como el backend usa
# network_mode: host, este es tambien el puerto en el que estara disponible
# directamente en tu maquina (http://localhost:8080).
BACKEND_PORT=8080

# Puerto en el que se expone la interfaz web (Nginx) en tu maquina.
FRONTEND_PORT=3000

# URL base que usara el frontend para llamar a la API del backend. Se incrusta
# en el bundle de JavaScript en tiempo de build, por lo que si cambias
# BACKEND_PORT debes actualizar tambien esta variable antes de reconstruir.
VITE_API_BASE_URL=http://localhost:8080/api

# --- Simulador de Phishing (opcional) ---
# NETKNIFE no trae credenciales de correo embebidas: para poder enviar
# simulaciones necesitas tu propia cuenta SMTP (ej. una cuenta de Gmail con
# una "contrasena de aplicacion", Outlook, o cualquier proveedor SMTP). Si no
# rellenas estas variables, el resto de la app funciona igual, pero el envio
# de simulaciones de phishing fallara con un error explicandolo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Direccion que vera el destinatario como remitente. Si la dejas vacia, se usa SMTP_USERNAME.
SMTP_FROM=
# URL por la que tu backend es alcanzable desde donde el destinatario abra el correo
# (para construir el enlace de seguimiento y la pagina educativa). Cambiala si usas
# Docker con un puerto distinto o si expones el backend en otra direccion/dominio.
PHISHING_TRACKING_BASE_URL=http://localhost:8080
