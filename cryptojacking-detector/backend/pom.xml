<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.netknife</groupId>
        <artifactId>netknife-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>netknife-cryptojacking-detector</artifactId>
    <packaging>jar</packaging>
    <name>netknife-cryptojacking-detector</name>
    <description>Detector de cryptojacking: monitoriza el uso de CPU por proceso para detectar
        patrones de minado oculto, con lista de procesos de minado conocidos e historial de
        alertas.</description>

    <dependencies>
        <dependency>
            <groupId>com.netknife</groupId>
            <artifactId>netknife-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>

        <!-- OSHI: libreria Java pura (usa JNA internamente, sin JNI propio que compilar)
             para telemetria de sistema multiplataforma (CPU, procesos, memoria...). Se usa
             aqui solo para leer CPU por proceso: OSHI no ofrece una API fiable multiplataforma
             de uso de GPU por proceso (eso requeriria herramientas especificas de cada
             fabricante), asi que el detector de cryptojacking se basa unicamente en CPU. -->
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
            <version>6.8.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
