<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.netknife</groupId>
        <artifactId>netknife-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>netknife-network-scanner</artifactId>
    <packaging>jar</packaging>
    <name>netknife-network-scanner</name>
    <description>Escaner de red domestica: descubrimiento pasivo de dispositivos y bloqueo
        por ARP spoofing (solo Windows, requiere Npcap).</description>

    <dependencies>
        <dependency>
            <groupId>com.netknife</groupId>
            <artifactId>netknife-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- SQLite JDBC driver + dialecto de Hibernate para SQLite -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>

        <!-- pcap4j: envio de paquetes ARP crudos para el bloqueo de dispositivos (ARP
             spoofing). Requiere Npcap instalado en Windows (con "WinPcap API-compatible
             Mode") y privilegios de administrador; ver blocking/BlockingCapabilityService,
             que detecta su ausencia en caliente y deshabilita el bloqueo con gracia. Se usa
             el packet factory "static" (en vez del que resuelve por reflexion) porque es mas
             fiable al empaquetarse dentro del fat jar de Spring Boot. -->
        <dependency>
            <groupId>org.pcap4j</groupId>
            <artifactId>pcap4j-core</artifactId>
            <version>1.8.2</version>
        </dependency>
        <dependency>
            <groupId>org.pcap4j</groupId>
            <artifactId>pcap4j-packetfactory-static</artifactId>
            <version>1.8.2</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
