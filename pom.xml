<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.netknife</groupId>
    <artifactId>netknife-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>netknife-parent</name>
    <description>NETKNIFE - agregador Maven multi-modulo: un modulo por herramienta, mas platform/common
        (codigo compartido) y platform/app (ensamblado final ejecutable)</description>

    <properties>
        <!-- Sin maven-toolchains-plugin a proposito: forzaba JDK 25 especificamente
             (resto de un intento de subir a Java 25 revertido por incompatibilidad con
             Spring Boot 3.3.4). Con release 21, cualquier JDK 21 o superior instalado
             (el que resuelva JAVA_HOME/PATH) compila bien sin necesitar un toolchains.xml
             con una entrada concreta; esto es lo que hace posible construir la imagen
             Docker (JDK 21 puro) sin fallos de "no matching toolchain". -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <modules>
        <module>platform/common</module>
        <module>network-scanner/backend</module>
        <module>exposure-checker/backend</module>
        <module>hygiene-checklist/backend</module>
        <module>phishing-simulator/backend</module>
        <module>port-radar/backend</module>
        <module>wifi-router-audit/backend</module>
        <module>digital-footprint/backend</module>
        <module>findings-report/backend</module>
        <module>cryptojacking-detector/backend</module>
        <module>traffic-analyzer/backend</module>
        <module>platform/app</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Permite ejecutar los tests con Mockito/ByteBuddy en JDKs mas
                         recientes que los oficialmente soportados por la version de
                         ByteBuddy que gestiona el BOM de Spring Boot. -->
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
